# Local accounts use this SQLite file. It does not require a PostgreSQL password.
DATABASE_URL=sqlite+pysqlite:///./docsmio.db
# Optional, once you have a real PostgreSQL user and database:
# DATABASE_URL=postgresql+psycopg://docsmio:change-me@127.0.0.1:5432/docsmio
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
LIBRARY_STORAGE_DIR=./storage
APP_ENV=development
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=300
REMINDER_LOOP=true
# Leave blank unless a mail server is configured. Email reminders stay skipped without these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Optional shared secret for POST /api/jobs/reminders. Leave blank to keep that route hidden.
REMINDER_CRON_TOKEN=
