# Local accounts use this SQLite file. It does not require a PostgreSQL password.
DATABASE_URL=sqlite+pysqlite:///./docufix.db
# Optional, once you have a real PostgreSQL user and database:
# DATABASE_URL=postgresql+psycopg://docufix:change-me@127.0.0.1:5432/docufix
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
LIBRARY_STORAGE_DIR=./storage
